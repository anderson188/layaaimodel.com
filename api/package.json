{
  "name": "layaaimodel-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml",
    "db:local": "wrangler d1 execute layaaimodel-api --local --config wrangler.toml --file=./schema.sql",
    "db:remote": "wrangler d1 execute layaaimodel-api --remote --config wrangler.toml --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute layaaimodel-api --local --config wrangler.toml --file=./migrate.sql",
    "db:migrate:remote": "wrangler d1 execute layaaimodel-api --remote --config wrangler.toml --file=./migrate.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250726.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.69.0"
  }
}
